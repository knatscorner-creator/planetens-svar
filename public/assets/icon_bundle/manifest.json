{
  "name": "game-ui-icons",
  "version": "1.2.0",
  "description": "Optimized small-UI icon set for the game UI. Idle PNG + hover WebM.",
  "asset_profile": {
    "target_ui_size_px": "approximately 32-48 CSS px",
    "png_size_px": 160,
    "webm_size_px": 160,
    "webm_codec": "VP9",
    "webm_fps": 24,
    "notes": "These assets are optimized for small on-screen icons instead of full-size viewing."
  },
  "conventions": {
    "default_state": "Use the PNG as the idle/default icon.",
    "hover_state": "On mouseenter, keep the PNG visible underneath, start the matching WebM, and only reveal the WebM once it can play. On mouseleave, pause/reset the WebM and show the PNG again.",
    "preload": "Preload WebM files only for icons that are actually present in the current UI/order list.",
    "visual_consistency": "Apply the same CSS filter/contrast treatment to both PNG and WebM.",
    "recommended_transition": "Fade the WebM in over the PNG over about 100-150 ms once the video is ready."
  },
